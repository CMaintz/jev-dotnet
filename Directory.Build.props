<Project>
  <!-- Shared build settings for every project in the solution. The gate runs
       `dotnet build -warnaserror`, so analyzer and nullable warnings fail CI. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- SonarAnalyzer.CSharp adds the structural-smell rules (method length, cyclomatic and
       cognitive complexity, too many parameters, file size). It is scoped to the sensor's
       own build: the reference loads only when CodeAnalysisRuleSet is set, which the
       habit-hooks dotnet sensor sets and typecheck does not. So typecheck never loads Sonar
       and cannot be flooded by it; the sensor builds with its ruleset, reads the structural
       warnings and ratchets them against the snooze baseline. Pinned; Renovate's nuget
       manager tracks this. PrivateAssets=all keeps it a build-time dev dependency so it
       never flows to consumers of the package. -->
  <ItemGroup Condition="'$(CodeAnalysisRuleSet)' != ''">
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" PrivateAssets="all" />
  </ItemGroup>
</Project>
